# Copy to web/.env.local for local development. Never commit real secrets.

# Postgres. Local: the database created in web/README.md.
# Vercel: Supabase transaction pooler, port 6543, user publicjobs_app.[project-ref],
# same host as the session pooler (aws-0-ca-central-1.pooler.supabase.com or
# aws-1-ca-central-1.pooler.supabase.com), database postgres, query sslmode=require.
# Do not use the session pooler (port 5432) on Vercel.
# This is the server connection. It is not the anon key, and it must not be
# prefixed with NEXT_PUBLIC_. Do not rotate the database password to change the port.
DATABASE_URL=postgres://publicjobs:publicjobs_local@127.0.0.1:5432/publicjobs

# Canonical origin used in links, sitemap, JSON-LD and llms.txt.
NEXT_PUBLIC_SITE_URL=https://publicjobs.ca

# Supabase Auth (hosted project). Leave blank to run without Auth.
# Use the publishable key. The legacy anon key is accepted as a fallback
# under NEXT_PUBLIC_SUPABASE_ANON_KEY. Never put the service role key in a
# NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google sign-in is shown unless this is exactly false.
GOOGLE_SIGN_IN=

# Signs the local-only dev cookie. Required only when ALLOW_LOCAL_LOGIN=true.
# Generate a long random string. Local login is refused unless the host is
# localhost or 127.0.0.1, so this cannot sign members in on Vercel.
AUTH_SECRET=
ALLOW_LOCAL_LOGIN=false

# Weekly email signup. This is the existing Cloudflare Worker. Do not change it.
NEXT_PUBLIC_SIGNUP_ENDPOINT=https://ontario-public-jobs-signup.publicjobs.workers.dev

# Resume match. The browser posts to this app (/api/match/). The server calls the
# Worker. Leave MATCH_TRUSTED_SECRET empty until workers/resume-match/ is deployed
# with the same secret. While it is empty, /match/ does not call the Worker.
# Never prefix the secret with NEXT_PUBLIC_, and never commit the value.
MATCH_WORKER_URL=https://publicjobs-resume-match.publicjobs.workers.dev/match
MATCH_TRUSTED_SECRET=

# Optional. Same public ids as the current site. Leave blank to omit the tags.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Stripe (server only). Never prefix these with NEXT_PUBLIC_. Never commit the values.
# STRIPE_SECRET_KEY is the secret key (sk_test_... while payments are in test mode).
# STRIPE_WEBHOOK_SECRET signs POST /api/stripe/webhook/ (trailing slash).
# On the Vercel preview, Stripe calls that path with ?x-vercel-protection-bypass=...
# The app ignores the query param. Vercel Authentication reads it before the app.
# Price ids: CA$14.99/month, CA$29.99 every 3 months, CA$59/year. Do not put a trial on the prices.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_QUARTERLY=
STRIPE_PRICE_YEARLY=
# Set to true only after Stripe Tax is activated in the Dashboard. Checkout does not send automatic_tax until then.
STRIPE_AUTOMATIC_TAX=

# Transactional membership email (server only). Sender is membership@publicjobs.ca.
RESEND_API_KEY=

# Authorizes GET/POST /api/cron/renewal-reminders/ and the Vercel cron in web/vercel.json.
CRON_SECRET=
