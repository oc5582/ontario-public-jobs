# Public site origin used for canonical URLs, sitemap, and auth redirects.
# Local: http://localhost:3000
# Production: https://publicjobs.ca
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings → API).
# The anon key is public. The service role key bypasses RLS — server and import only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection for the import script and for local `next dev`
# when you are not calling the Supabase Data API.
# Supabase: Project Settings → Database → URI (use the pooler for the app,
# the direct URI for the import script if the pooler rejects session SQL).
DATABASE_URL=

# Optional override. When unset, local dev reads ../data/listings.json
# (the repo feed) if that file exists. On Vercel this file is not deployed;
# set DATABASE_URL or the Supabase keys above.
LISTINGS_PATH=

# Local screenshot / member-list testing only. Never set these on Vercel.
# Visit /sign-in/ and use "Continue as test member".
ALLOW_DEV_MEMBER=
DEV_MEMBER_TOKEN=

# Stripe — leave blank in phase 1. No keys are required to build or run.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs created later in Stripe (CAD):
# STRIPE_PRICE_MONTHLY=
# STRIPE_PRICE_QUARTERLY=
# STRIPE_PRICE_ANNUAL=
